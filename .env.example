# =============================================================================
# Reference copy of env keys — edit the real file: `.env` in the project root
# (same folder as package.json). Vite and `src/env.ts` load that file.
# =============================================================================
#
# --- Real extension vs browser dev ---
# `extension` — force extension-style behavior (still no VS Code API in plain Vite).
# `browser`   — mocks install; in-page Socket.IO.
# (empty)     — auto: extension when `acquireVsCodeApi` exists (webview), else browser.
#
# To use the REAL extension: leave this empty or set `extension`, build the webview,
# then in Cursor run **“Tursor: Open panel”** (do not rely on `npm run dev` alone).
#
VITE_APP_RUNTIME=

# Socket.IO client (webview / browser). Extension host bridge still targets this backend.
VITE_TURSOR_SOCKET_URL=http://127.0.0.1:9090
VITE_TURSOR_SOCKET_PATH=/ws

# Run page preview iframe `src` (must match your backend / CSP).
VITE_RUNPAGE_EMBED_URL=http://127.0.0.1:9090/

# When `true` and Vite is in dev mode, show the small runtime pill (browser / extension).
VITE_SHOW_RUNTIME_DEV_BADGE=true
